{
  "name": "one_for_the_city",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply oneforthecity --local",
    "db:migrate:remote": "wrangler d1 migrations apply oneforthecity --remote",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "lint": "vp lint .",
    "fmt": "vp fmt",
    "wrangler": "wrangler",
    "drizzle": "drizzle-kit",
    "dev:stripe": "stripe listen --forward-to localhost:5173/store/webhook/stripe",
    "prod:secrets": "wrangler secret bulk .env.wrangler-secrets"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@unpic/react": "^1.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "stripe": "^23.2.0",
    "tabler-icons-react": "^1.56.0",
    "tailwind-merge": "^3.7.1",
    "tanstack-router-ga4": "^1.6.4",
    "typescript": "^7.0.2",
    "use-shopping-cart": "4.0.0-rc.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "oxc-transform-react": "^0.156.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plus": "^1.8.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "browserslist": "defaults, not ie <= 11",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
